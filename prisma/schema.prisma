// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String     @unique
  password      String
  firstName     String?
  lastName      String?
  avatar        String?
  phoneNumber   String?
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  wallet        Wallet?
  kyc           KYC?
  transactions  Transaction[]
  notifications Notification[]
  bets          Bet[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Decimal  @default(0) @db.Decimal(18, 2)
  bonusBalance  Decimal  @default(0) @db.Decimal(18, 2)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Decimal  @db.Decimal(18, 2)
  type          String   // DEPOSIT, WITHDRAWAL, REFUND, BONUS
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED
  description   String?
  reference     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("transactions")
}

model KYC {
  id            String   @id @default(cuid())
  userId        String   @unique
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  documentType  String?
  documentId    String?
  documentUrl   String?
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  rejectionReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc")
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  title         String
  message       String
  type          String   // INFO, SUCCESS, WARNING, ERROR
  read          Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model Bet {
  id            String   @id @default(cuid())
  userId        String
  amount        Decimal  @db.Decimal(18, 2)
  odds          Decimal  @db.Decimal(10, 2)
  potential     Decimal  @db.Decimal(18, 2)
  status        String   @default("ACTIVE") // ACTIVE, WON, LOST, CANCELED
  eventId       String
  selections    String[] // JSON array of bet selections
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  settledAt     DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("bets")
}

model SportsEvent {
  id            String   @id @default(cuid())
  title         String
  description   String?
  sport         String   // FOOTBALL, BASKETBALL, TENNIS, etc.
  league        String?
  homeTeam      String?
  awayTeam      String?
  eventDate     DateTime
  status        String   @default("SCHEDULED") // SCHEDULED, LIVE, FINISHED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sport])
  @@index([eventDate])
  @@index([status])
  @@map("sports_events")
}
